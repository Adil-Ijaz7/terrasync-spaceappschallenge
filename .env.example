# CARTO Basemaps API Key
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# Automated Email Gateway (Gmail App Password, SendGrid, or AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TerraSync Orbital Sentinel" <your_email@gmail.com>

# Optional Supabase Cloud DB (fallback to local mock persistence if not configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
